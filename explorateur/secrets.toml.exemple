# Gabarit des secrets de l'explorateur.
#
# En local  : copier vers `.streamlit/secrets.toml`, qui est ignore par git.
# En ligne  : coller le contenu dans la configuration de l'hebergeur.
#
# **Aucun mot de passe en clair, jamais.** Chaque valeur est une empreinte PBKDF2-SHA256
# salee, fabriquee par :
#
#     python -m explorateur.empreinte --identifiant marie
#
# La commande demande le mot de passe sans echo et rend la ligne a coller ci-dessous.

[comptes]
# marie = "a1b2...$c3d4..."
